{
  "manifest_version": 3,
  "name": "Baton: AI Chat Transfer",
  "version": "1.0.2",
  "description": "Move a conversation between ChatGPT, Claude and Gemini. Export as Markdown, import anywhere. Everything stays on your device.",
  "permissions": ["storage"],
  "action": {
    "default_title": "Baton",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
